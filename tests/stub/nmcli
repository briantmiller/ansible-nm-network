#!/bin/sh
# Fake nmcli for scripts/dryrun.sh: no connections exist, every change succeeds.
echo "$*" >> "${NMCLI_STUB_LOG:-/dev/null}"
case "$*" in
  --version) echo "nmcli tool, version 1.46.0"; exit 0 ;;
  *"--fields name"*"con show") exit 0 ;;
  *"connection show"*|*"con show"*) echo "Error: no such connection profile." >&2; exit 10 ;;
esac
exit 0
